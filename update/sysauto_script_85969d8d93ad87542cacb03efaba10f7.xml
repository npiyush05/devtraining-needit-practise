        <script><![CDATA[(function() {

    // Create GlideRecord for NeedIt Task table
    var gr = new GlideRecord('x_58872_needit_needit_task');

    // Query for overdue tasks
    gr.addQuery('due_date', '<', gs.nowDateTime()); // Due date in the past
    gr.addQuery('state', '!=', '3'); // Not Closed (adjust based on your state values)
    gr.query();

    while (gr.next()) {

        // Log message to Application Logs
        gs.info('Overdue NeedIt Task found: ' + gr.number);

        // Trigger event for overdue task
        gs.eventQueue('x_58872_needit.overdueNeedItTask', gr, gr.assigned_to, gr.number);

    }

})();]]></script>
